library(tidyverse)
library(ggplot2)
library(readxl)
library(dplyr)
library(lmerTest)
library(emmeans)
library(sjPlot)
Data_Testable <- read_delim("Data_Testable.csv", 
                            delim = ";", escape_double = FALSE, col_types = cols(Participant = col_integer(), 
                                                                                 TargetModality = col_factor(levels = c("Tactile", 
                                                                                                                        "Acoustic")),
                                                                                 Target = col_factor(levels = c("Leather", "Felt", "Aluminium", "Sandpaper",
                                                                                                                "Wood", "Country Music7", "VideoGame3", 
                                                                                                                "Knocking", "Bell4", "CarHorn")), 
                                                                                 Modulator = col_factor(levels = c("Leather", 
                                                                                                                   "Felt", "Aluminium", "Sandpaper", 
                                                                                                                   "Wood", "Country Music7", "VideoGame3", 
                                                                                                                   "Knocking", "Bell4", "CarHorn", "None")), 
                                                                                 Valence = col_integer(), Arousal = col_integer()), 
                            trim_ws = TRUE)

#Uncalibrated sets

data_acoustic <- Data_Testable %>%
  filter(TargetModality == "Acoustic") %>%
  mutate(Modulator = relevel(as.factor(Modulator), ref = "None"))

data_tactile <- Data_Testable %>%
  filter(TargetModality == "Tactile") %>%
  mutate(Modulator = relevel(as.factor(Modulator), ref = "None"))


#Calibrated sets
data_acoustic_cal <- Data_Testable %>%
  filter(TargetModality == "Acoustic",
         Modulator %in% c("None",
                          "Leather", 
                          "Felt", "Aluminium",
                          "Sandpaper", "Wood")) %>%
  mutate(Modulator = droplevels(Modulator)) %>%
  mutate(Modulator = relevel(Modulator, ref = "None"))

data_tactile_cal <- Data_Testable %>%
  filter(TargetModality == "Tactile",
         Modulator %in% c("None",
                          "Country Music7","VideoGame3",
                          "Knocking","Bell4","CarHorn")) %>%
  mutate(Modulator = droplevels(Modulator)) %>%
  mutate(Modulator = relevel(Modulator, ref = "None"))

data_combined_cal <- bind_rows(data_tactile_cal, data_acoustic_cal)
summary(data_combined_cal)
data_long <- data_combined_cal %>%
  pivot_longer(cols = c(Valence, Arousal), names_to = "DependentVar", values_to = "Score")


#Can the modes Touch and Hearing modulate each others perceptive valence and arousal?
#Visualize the measurements
Data_Testable %>%
  group_by(TargetModality) %>%
  summarize(var(Arousal))

