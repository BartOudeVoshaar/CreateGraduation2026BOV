# Acoustic-only plot
ggplot(data_long %>% filter(TargetModality == "Acoustic"), 
       aes(x = Modulator, y = Score, color = Modulator)) +
  geom_jitter(aes(group = Participant), width = 0.1, alpha = 0.5) +
  stat_summary(fun = mean, geom = "point", size = 3) +
  stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
  facet_wrap(~DependentVar, scales = "free_y") +
  theme_minimal() +
  labs(x = "Modulator", y = "Score", color = "Modulator") +
  theme(strip.text = element_text(face = "bold"),
        axis.text.x = element_text(angle = 45, hjust = 1),
        legend.position = "bottom")


#----------NO CALIBRATION USED----------#

#Test the effect of sound on Arousal
model_TactArousal_NoCal <- lmer(
  Arousal ~ Modulator + (1|Participant),
  data = data_tactile
)
anova(model_TactArousal_NoCal, type = 3)
summary(model_TactArousal_NoCal)

#Test the effect of touch on Arousal
model_AcouArousal_NoCal <- lmer(
  Arousal ~ Modulator + (1|Participant),
  data = data_acoustic
)
anova(model_AcouArousal_NoCal, type = 3)
summary(model_AcouArousal_NoCal)


#------------------NOW FOR THE VALENCE------------------#

#Test the effect of sound on Valence
model_TactValence_NoCal <- lmer(
  Valence ~ Modulator + (1|Participant),
  data = data_tactile
)
anova(model_TactValence_NoCal, type = 3)
summary(model_TactValence_NoCal)

#Test the effect of touch on Valence
model_AcouValence_NoCal <- lmer(
  Valence ~ Modulator + (1|Participant),
  data = data_acoustic
)
anova(model_AcouValence_NoCal, type = 3)
summary(model_AcouValence_NoCal)



#-------------------NOW ADD AROUSAL CALIBRATION-------------------
model_mvb_TactileArou <- lmer(
  Arousal ~ Modulator + (1 | Participant),
  data = data_tactile_cal
)

anova(model_mvb_TactileArou, type = 3)
summary(model_mvb_TactileArou)

model_mvb_AcousticArou <- lmer(
  Arousal ~ Modulator + (1 | Participant),
  data = data_acoustic_cal
)

anova(model_mvb_AcousticArou, type = 3)
summary(model_mvb_AcousticArou)



#-------------------NOW ADD VALENCE CALIBRATION-------------------
model_mvb_TactileVal <- lmer(
  Valence ~ Modulator + (1 | Participant),
  data = data_tactile_cal
)

anova(model_mvb_TactileVal, type = 3)
summary(model_mvb_TactileVal)

model_mvb_AcousticVal <- lmer(
  Valence ~ Modulator + (1 | Participant),
  data = data_acoustic_cal
)

anova(model_mvb_AcousticVal, type = 3)
summary(model_mvb_AcousticVal)


#Estimated Marginal Means
model_emm_tact <- lmer (Valence ~Modulator + (1 | Participant), data = data_tactile_cal)
emm_tact <- emmeans(model_emm_tact, ~ Modulator)

model_emm_acou <- lmer (Valence ~Modulator + (1 | Participant), data = data_acoustic_cal)
emm_acou <- emmeans(model_emm_acou, ~ Modulator)

#Visualisation of Models
plot(emm_tact)
summary(emm_tact)
plot(emm_acou)
summary(emm_acou)

ggplot(data_tactile_cal, aes(x = Modulator, y = Valence)) +
  geom_boxplot() +
  stat_summary(fun = mean, geom = "point", color = "red") +
  labs(title = "Valence per Modulator for Tactile Targets",
       y = "Valence", x = "Acoustic Modulator")

ggplot(data_acoustic_cal, aes(x = Modulator, y = Valence)) +
  geom_boxplot() +
  stat_summary(fun = mean, geom = "point", color = "red") +
  labs(title = "Valence per Modulator for Acoustic Targets",
       y = "Valence", x = "Tactile Modulator")

tab_model(model_mvb_TactileVal, model_mvb_AcousticVal,
          model_mvb_TactileArou, model_mvb_AcousticArou,
          show.se = TRUE, show.stat = TRUE)

tab_model(model_mvb_AcousticVal, file = "mvbTactileVal.doc")
tab_model(model_mvb_AcousticVal, file = "mvbAcousticVal.doc")


